var FORM_HTML = "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<base target=\"_top\">\n<title>Recursos — Prêmio TJAC de Qualidade 2026</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Open+Sans:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  /* Identidade visual do Poder Judiciário do Estado do Acre (vinho) */\n  --azul:#a01027; --azul-esc:#5c0b1b; --azul-claro:#84172e; --ouro:#e7c3ca; --verde:#1d7a46; --vinho-suave:#f8eef0;\n  --cinza-campo:#ebebeb; --cinza-borda:#d6d6d6; --texto:#222; --texto-suave:#5c5c5c;\n  --erro:#b3261e; --erro-fundo:#fdecea; --ok:#1d7a46; --ok-fundo:#e7f4ec; --alerta-fundo:#fff6dc;\n  --fundo:#f3f4f6; --cartao:#fff;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{background:var(--fundo);color:var(--texto);font-family:\"Open Sans\",Arial,sans-serif;font-size:15px;line-height:1.5}\na{color:var(--azul-claro)}\n.sr{position:absolute;left:-9999px}\n\n/* ---------- Cabeçalho inspirado no portal www.tjac.jus.br ---------- */\n.barra-topo{background:var(--azul-esc);color:#f1d9de;font-size:12px}\n.barra-topo .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:6px 16px}\n.barra-topo a{color:#f1d9de;text-decoration:none;margin-left:14px}\n.barra-topo a:hover{color:#fff}\n.cab{background:var(--azul);color:#fff;border-bottom:4px solid var(--azul-claro)}\n.cab .wrap{display:flex;align-items:center;gap:16px;padding:18px 16px}\n.brasao{width:88px;height:88px;flex:0 0 88px;margin:-8px 0;display:grid;place-items:center;overflow:hidden}\n.brasao img{width:100%;height:100%;object-fit:contain}\n.cab .tit small{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#f6dde2}\n.cab .tit strong{display:block;font-family:Merriweather,Georgia,serif;font-size:22px;line-height:1.25}\n.menu{background:var(--azul-claro)}\n.menu .wrap{display:flex;gap:2px;flex-wrap:wrap;padding:0 8px}\n.menu a{color:#fff;text-decoration:none;font-size:13px;font-weight:600;padding:10px 10px;display:block}\n.menu a:hover,.menu a.ativo{background:var(--azul-esc)}\n.wrap{max-width:1000px;margin:0 auto}\n\n/* ---------- Corpo do formulário (estrutura do formulário do CNJ) ---------- */\nmain{padding:20px 16px 40px}\n.folha{background:var(--cartao);max-width:1000px;margin:0 auto;padding:28px 32px 36px;border-radius:4px;box-shadow:0 1px 3px rgba(0,0,0,.08)}\nh1.titulo-form{font-family:Merriweather,Georgia,serif;font-size:15px;font-weight:700;margin:0 0 14px}\n.abas{display:flex;gap:6px;margin:0 auto 14px;max-width:1000px;flex-wrap:wrap}\n.abas button{border:1px solid var(--cinza-borda);background:#fff;color:var(--azul);padding:9px 14px;border-radius:999px;font-weight:600;cursor:pointer;font-size:13px}\n.abas button[aria-selected=true]{background:var(--azul);color:#fff;border-color:var(--azul)}\n.passo-txt{font-family:Merriweather,Georgia,serif;font-size:12px;color:#777;margin:8px 0 6px 10px}\n.progresso{background:#e4e4e4;border-radius:999px;padding:7px;margin-bottom:26px}\n.progresso div{height:20px;border-radius:999px;background:repeating-linear-gradient(-45deg,#84172e 0 12px,#a01027 12px 24px);color:#fff;font-size:11px;text-align:right;padding-right:10px;line-height:20px;transition:width .3s}\nh2.secao{font-family:Merriweather,Georgia,serif;font-size:14px;font-weight:700;margin:30px 0 22px;padding-bottom:12px;border-bottom:1px solid var(--cinza-borda)}\n.campo{margin:0 0 26px}\n.campo>label,.campo>.rot{display:block;font-family:Merriweather,Georgia,serif;font-weight:700;font-size:13.5px;margin-bottom:8px}\n.obrig{color:var(--texto)}\n.ajuda{font-size:12.5px;color:var(--texto-suave);margin-top:5px}\ninput[type=text],input[type=email],input[type=number],input[type=date],select,textarea{width:100%;border:0;background:var(--cinza-campo);padding:11px 12px;font:inherit;font-size:14px;border-radius:2px;color:var(--texto)}\nselect{border:1px solid #bbb;background:#fafafa;max-width:420px}\nselect.largo{max-width:100%}\ninput:focus,select:focus,textarea:focus{outline:2px solid var(--azul-claro);outline-offset:1px}\ntextarea{min-height:110px;resize:vertical}\ntextarea.grande{min-height:140px}\n.contador{font-family:Merriweather,Georgia,serif;font-size:11.5px;color:#777;margin-top:4px}\n.contador.estouro{color:var(--erro);font-weight:700}\n.opcoes label{display:block;padding-left:24px;text-indent:-24px;font-family:Merriweather,Georgia,serif;font-size:13px;margin:0 0 12px;cursor:pointer;font-weight:400}\n.opcoes input{margin:0 9px 0 0;vertical-align:-2px;width:15px;height:15px;accent-color:#a01027}\n.opcoes label .selo{text-indent:0}\n.opcoes label.marcado{font-weight:700}\n.selo{display:inline-block;font-family:\"Open Sans\",Arial,sans-serif;font-size:10.5px;font-weight:700;padding:1px 7px;border-radius:999px;margin-left:6px;vertical-align:1px}\n.selo.pts{background:var(--vinho-suave);color:var(--azul)}\n.selo.prov{background:var(--ok-fundo);color:var(--ok)}\n.grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px 18px}\n.grade .campo{margin:0}\n.bloco-recurso{border-left:3px solid var(--azul-claro);padding:4px 0 4px 18px;margin:8px 0 34px}\n.bloco-recurso>.rot{font-family:Merriweather,Georgia,serif;font-weight:700;font-size:13.5px;margin:0 0 8px}\nfieldset.evid{border:1px solid var(--cinza-borda);border-radius:4px;padding:14px 16px 18px;margin:18px 0}\nfieldset.evid legend{font-weight:700;font-size:13px;color:var(--azul);padding:0 6px}\nfieldset.evid .letra{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--azul);color:#fff;font-size:11px;margin-right:6px}\n.subtit{font-weight:700;font-size:13px;margin:14px 0 8px}\n.arquivo{font-size:13px}\n.arquivo input{font-size:13px}\n.lista-arq{font-size:12.5px;color:var(--texto-suave);margin:6px 0 0;padding-left:18px}\n.aviso{border-radius:4px;padding:12px 14px;font-size:13.5px;margin:0 0 18px}\n.aviso.info{background:var(--vinho-suave);border-left:4px solid var(--azul-claro)}\n.aviso.alerta{background:var(--alerta-fundo);border-left:4px solid var(--ouro)}\n.aviso.erro{background:var(--erro-fundo);border-left:4px solid var(--erro)}\n.aviso.ok{background:var(--ok-fundo);border-left:4px solid var(--ok)}\n.aviso>strong:first-child{display:block;margin-bottom:2px}\n.erro-campo{color:var(--erro);font-size:12.5px;margin-top:5px}\n.invalido{outline:2px solid var(--erro)!important}\n.checklist{list-style:none;padding:0;margin:8px 0 0;font-size:13px}\n.checklist li{padding:3px 0}\n.checklist li::before{content:\"○ \";color:#999}\n.checklist li.ok::before{content:\"✔ \";color:var(--ok)}\n.checklist li.nok::before{content:\"✖ \";color:var(--erro)}\nhr.pont{border:0;border-top:1px dotted #bbb;margin:26px 0 22px}\n.botoes{display:flex;flex-direction:column;gap:10px}\n.btn{display:block;width:100%;border:0;border-radius:999px;background:var(--azul);color:#fff;font:inherit;font-weight:600;padding:12px 18px;cursor:pointer;font-size:14px}\n.btn:hover{background:var(--azul-esc)}\n.btn[disabled]{opacity:.45;cursor:not-allowed}\n.btn.sec{background:#fff;color:var(--azul);border:1px solid var(--azul)}\n.btn.peq{display:inline-block;width:auto;padding:7px 14px;font-size:13px}\n.servidor{border:1px solid var(--cinza-borda);border-radius:4px;padding:14px 16px;margin:0 0 16px;position:relative}\n.servidor .remover{position:absolute;top:8px;right:10px;background:none;border:0;color:var(--erro);cursor:pointer;font-size:13px}\n.meses{font-size:12.5px;margin-top:6px}\n.resumo dt{font-weight:700;font-size:13px;margin-top:8px}\n.resumo dd{margin:0 0 4px}\n.oculto{display:none!important}\n.carregando{position:fixed;inset:0;background:rgba(255,255,255,.75);display:grid;place-items:center;z-index:50}\n.carregando div{background:#fff;padding:22px 26px;border-radius:6px;box-shadow:0 4px 18px rgba(0,0,0,.15);font-weight:600}\ndialog{border:0;border-radius:6px;max-width:560px;width:calc(100% - 32px);padding:24px;box-shadow:0 10px 40px rgba(0,0,0,.3)}\ndialog::backdrop{background:rgba(0,0,0,.45)}\ndialog h3{margin:0 0 10px;font-family:Merriweather,Georgia,serif;font-size:16px}\ndialog .acoes{display:flex;gap:10px;justify-content:flex-end;margin-top:18px;flex-wrap:wrap}\n\n/* ---------- Rodapé ---------- */\n.rodape-form{background:#ebebec;text-align:center;font-family:Merriweather,Georgia,serif;font-size:12px;padding:34px 16px;color:#333;max-width:1032px;margin:28px auto 0}\n.rodape{background:var(--azul-esc);color:#f1d9de;font-size:13px;margin-top:0}\n.rodape .wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;padding:26px 16px}\n.rodape h4{color:#fff;margin:0 0 8px;font-size:13px;text-transform:uppercase;letter-spacing:.06em}\n.rodape a{color:#f1d9de;display:block;text-decoration:none;margin:3px 0}\n.rodape a:hover{color:#fff}\n.rodape .base{border-top:1px solid rgba(255,255,255,.12);text-align:center;padding:10px 16px;font-size:12px}\n\n@media (max-width:640px){\n  .folha{padding:20px 16px 28px}\n  .cab .tit strong{font-size:17px}\n  .brasao{width:52px;height:52px;flex-basis:52px}\n  .barra-topo .acess{display:none}\n}\n@media print{.barra-topo,.menu,.abas,.botoes,.rodape{display:none}}\n</style>\n</head>\n<body>\n\n<div class=\"barra-topo\"><div class=\"wrap\">\n  <span>Poder Judiciário do Estado do Acre</span>\n  <span class=\"acess\"><a href=\"#conteudo\">Ir para o conteúdo</a><a href=\"https://www.tjac.jus.br\" target=\"_blank\" rel=\"noopener\">Portal do TJAC</a><a href=\"https://www.tjac.jus.br/ouvidoria/\" target=\"_blank\" rel=\"noopener\">Ouvidoria</a></span>\n</div></div>\n<header class=\"cab\"><div class=\"wrap\">\n  <div class=\"brasao\"><img src=\"data:image/png;base64,\" alt=\"Símbolo do Poder Judiciário do Estado do Acre\"></div>\n  <div class=\"tit\"><small>Poder Judiciário do Estado do Acre</small><strong>Tribunal de Justiça do Estado do Acre</strong></div>\n</div></header>\n<nav class=\"menu\" aria-label=\"Portal do TJAC\"><div class=\"wrap\">\n  <a href=\"https://www.tjac.jus.br\" target=\"_blank\" rel=\"noopener\">Início</a>\n  <a href=\"https://www.tjac.jus.br/institucional/\" target=\"_blank\" rel=\"noopener\">Institucional</a>\n  <a href=\"https://www.tjac.jus.br/transparencia/\" target=\"_blank\" rel=\"noopener\">Transparência</a>\n  <a class=\"ativo\" href=\"#conteudo\">Prêmio TJAC de Qualidade 2026</a>\n</div></nav>\n\n<main id=\"conteudo\">\n  <div class=\"abas\" role=\"tablist\">\n    <button role=\"tab\" aria-selected=\"true\" data-aba=\"recurso\">Recurso contra o Resultado Preliminar</button>\n    <button role=\"tab\" aria-selected=\"false\" data-aba=\"impugnacao\">Impugnação da lista de servidores vinculados</button>\n  </div>\n\n  <!-- ===================== RECURSO ===================== -->\n  <section class=\"folha\" id=\"aba-recurso\">\n    <h1 class=\"titulo-form\">Prêmio TJAC de Qualidade 2026 - Formulário para submissão de recursos contra o Resultado Preliminar</h1>\n    <div id=\"faixa-prazo\"></div>\n    <div class=\"passo-txt\" id=\"r-passo-txt\">Passo 1 de 2</div>\n    <div class=\"progresso\"><div id=\"r-barra\" style=\"width:50%\">50%</div></div>\n\n    <!-- PASSO 1 -->\n    <div id=\"r-passo1\">\n      <h2 class=\"secao\">Identificação do Respondente</h2>\n      <div class=\"campo\">\n        <label for=\"r-orgao\">Identifique o Órgão: <span class=\"obrig\">*</span></label>\n        <select id=\"r-orgao\" disabled><option>Tribunal de Justiça do Estado do Acre</option></select>\n      </div>\n      <div class=\"campo\">\n        <label for=\"r-unidade\">Identifique a Unidade Judiciária: <span class=\"obrig\">*</span></label>\n        <input type=\"text\" id=\"r-busca\" placeholder=\"Digite parte do nome para filtrar a lista…\" style=\"max-width:420px;margin-bottom:8px\" autocomplete=\"off\">\n        <select id=\"r-unidade\" class=\"largo\"></select>\n        <div class=\"ajuda\">Lista das unidades avaliadas (Portaria PRESI nº 1.961/2026, art. 4º). Código da serventia: <strong id=\"r-codigo\">—</strong></div>\n        <div id=\"r-status-unidade\" style=\"margin-top:10px\"></div>\n      </div>\n      <div class=\"campo\">\n        <label for=\"r-cpf\">Informe o CPF do responsável pelo envio: <span class=\"obrig\">*</span></label>\n        <input type=\"text\" id=\"r-cpf\" inputmode=\"numeric\" maxlength=\"14\" placeholder=\"000.000.000-00\">\n      </div>\n      <div class=\"campo\">\n        <label for=\"r-nome\">Informe o nome do responsável pelo envio: <span class=\"obrig\">*</span></label>\n        <input type=\"text\" id=\"r-nome\" maxlength=\"150\">\n      </div>\n      <div class=\"campo\">\n        <label for=\"r-email\">Informe o e-mail do responsável pelo envio: <span class=\"obrig\">*</span></label>\n        <input type=\"email\" id=\"r-email\" maxlength=\"150\" placeholder=\"nome@tjac.jus.br\">\n        <div class=\"ajuda\">O registro do recurso (PDF) será enviado para este endereço.</div>\n      </div>\n      <div class=\"campo\" id=\"r-cod-box\">\n        <label for=\"r-codemail\">Informe o código de verificação enviado ao e-mail: <span class=\"obrig\">*</span></label>\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center\">\n          <input type=\"text\" id=\"r-codemail\" inputmode=\"numeric\" maxlength=\"6\" style=\"max-width:160px\" placeholder=\"000000\">\n          <button type=\"button\" class=\"btn sec peq\" id=\"r-pedircod\">Enviar código para o e-mail</button>\n        </div>\n        <div class=\"ajuda\" id=\"r-cod-info\">Confirma que o envio parte de e-mail institucional (evita recurso em nome de outra unidade).</div>\n      </div>\n      <div class=\"grade\">\n        <div class=\"campo\">\n          <label for=\"r-cargo\">Informe o cargo/função do responsável: <span class=\"obrig\">*</span></label>\n          <select id=\"r-cargo\" class=\"largo\">\n            <option value=\"\">Selecione…</option>\n            <option>Juiz(a) de Direito titular</option>\n            <option>Juiz(a) de Direito designado(a)/substituto(a)</option>\n            <option>Desembargador(a)</option>\n            <option>Diretor(a) de Secretaria / Gestor(a) da unidade</option>\n            <option>Chefe de Gabinete</option>\n            <option>Secretário(a) / Coordenador(a)</option>\n            <option>Outro (por delegação)</option>\n          </select>\n        </div>\n        <div class=\"campo\">\n          <label for=\"r-matricula\">Informe a matrícula: <span class=\"obrig\">*</span></label>\n          <input type=\"text\" id=\"r-matricula\" maxlength=\"20\">\n        </div>\n      </div>\n      <hr class=\"pont\">\n      <div class=\"botoes\"><button class=\"btn\" id=\"r-avancar\" type=\"button\">Próximo</button></div>\n    </div>\n\n    <!-- PASSO 2 -->\n    <div id=\"r-passo2\" class=\"oculto\">\n      <div class=\"aviso info\"><strong>Unidade: <span id=\"r-unidade-resumo\"></span></strong>\n        Os recursos devem ser objetivos e acompanhados das evidências do Anexo III, item 3 (painel/relatório, filtros, período, memória de cálculo, número e quantidade exata dos processos), sob pena de não conhecimento (art. 13).</div>\n      <h2 class=\"secao\">Questionário</h2>\n      <div id=\"r-eixos\"></div>\n\n      <h2 class=\"secao\">Declarações</h2>\n      <div class=\"opcoes\" id=\"r-declaracoes\">\n        <label><input type=\"checkbox\" data-decl=\"preclusao\"> Declaro ciência de que a interposição deste recurso implica <strong>preclusão consumativa</strong>: não será admitido novo recurso desta unidade (art. 7º, § 4º).</label>\n        <label><input type=\"checkbox\" data-decl=\"reformatio\"> Declaro ciência de que a análise dos recursos pode ensejar <strong>acréscimo ou decréscimo</strong> da pontuação desta e das demais unidades, inclusive por reprocessamento dos dados (art. 13, § 2º).</label>\n        <label><input type=\"checkbox\" data-decl=\"veracidade\"> Declaro que as informações e evidências apresentadas são verdadeiras e foram extraídas das fontes oficiais indicadas.</label>\n      </div>\n\n      <div class=\"aviso alerta\" id=\"r-checklist-box\">\n        <strong>Checklist de admissibilidade (Anexo III, item 3)</strong>\n        <ul class=\"checklist\" id=\"r-checklist\"><li>Selecione ao menos um item para recorrer.</li></ul>\n      </div>\n      <div id=\"r-erros\"></div>\n      <hr class=\"pont\">\n      <div class=\"botoes\">\n        <button class=\"btn\" id=\"r-voltar\" type=\"button\">Anterior</button>\n        <button class=\"btn\" id=\"r-enviar\" type=\"button\">Enviar</button>\n      </div>\n    </div>\n\n    <!-- CONFIRMAÇÃO -->\n    <div id=\"r-final\" class=\"oculto\"></div>\n  </section>\n\n  <!-- ===================== IMPUGNAÇÃO ===================== -->\n  <section class=\"folha oculto\" id=\"aba-impugnacao\">\n    <h1 class=\"titulo-form\">Prêmio TJAC de Qualidade 2026 - Formulário de impugnação da lista provisória de servidores vinculados</h1>\n    <div class=\"aviso info\"><strong>Processamento autônomo</strong>\n      A impugnação da lista de servidores tem processamento próprio e <strong>não está sujeita à preclusão consumativa</strong> dos recursos (art. 7º, § 5º). Parâmetro: vinculação à unidade em que o(a) servidor(a) permaneceu lotado(a) por, no mínimo, 6 meses durante o período de apuração (art. 6º); excluem-se os punidos com suspensão ou demissão em 2026 (art. 6º, § 3º). Lista definitiva: 16/12/2026.</div>\n    <div id=\"i-form\">\n      <h2 class=\"secao\">Identificação do Respondente</h2>\n      <div class=\"campo\">\n        <label for=\"i-unidade\">Identifique a Unidade Judiciária: <span class=\"obrig\">*</span></label>\n        <select id=\"i-unidade\" class=\"largo\"></select>\n      </div>\n      <div class=\"grade\">\n        <div class=\"campo\"><label for=\"i-cpf\">CPF do responsável: *</label><input type=\"text\" id=\"i-cpf\" inputmode=\"numeric\" maxlength=\"14\" placeholder=\"000.000.000-00\"></div>\n        <div class=\"campo\"><label for=\"i-matricula\">Matrícula: *</label><input type=\"text\" id=\"i-matricula\" maxlength=\"20\"></div>\n      </div>\n      <div class=\"campo\" style=\"margin-top:22px\"><label for=\"i-nome\">Nome do responsável pelo envio: *</label><input type=\"text\" id=\"i-nome\" maxlength=\"150\"></div>\n      <div class=\"campo\"><label for=\"i-email\">E-mail do responsável pelo envio: *</label><input type=\"email\" id=\"i-email\" maxlength=\"150\" placeholder=\"nome@tjac.jus.br\"></div>\n      <div class=\"campo\" id=\"i-cod-box\">\n        <label for=\"i-codemail\">Informe o código de verificação enviado ao e-mail: <span class=\"obrig\">*</span></label>\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center\">\n          <input type=\"text\" id=\"i-codemail\" inputmode=\"numeric\" maxlength=\"6\" style=\"max-width:160px\" placeholder=\"000000\">\n          <button type=\"button\" class=\"btn sec peq\" id=\"i-pedircod\">Enviar código para o e-mail</button>\n        </div>\n        <div class=\"ajuda\" id=\"i-cod-info\">Confirma que o envio parte de e-mail institucional (evita recurso em nome de outra unidade).</div>\n      </div>\n\n      <h2 class=\"secao\">Servidores(as) objeto da impugnação</h2>\n      <div id=\"i-servidores\"></div>\n      <button type=\"button\" class=\"btn sec peq\" id=\"i-add\">+ Adicionar servidor(a)</button>\n\n      <h2 class=\"secao\">Fundamentação e evidências</h2>\n      <div class=\"campo\">\n        <label for=\"i-fund\">Apresente a fundamentação da impugnação: *</label>\n        <textarea id=\"i-fund\" class=\"grande\" maxlength=\"4000\"></textarea>\n        <div class=\"contador\" data-para=\"i-fund\">0 de 4000 máx. de caracteres</div>\n      </div>\n      <div class=\"campo arquivo\">\n        <label for=\"i-arq\">Anexe as evidências (portaria de lotação, extrato do sistema de RH etc.):</label>\n        <input type=\"file\" id=\"i-arq\" multiple accept=\".pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv,.docx,.doc\">\n        <ul class=\"lista-arq\" id=\"i-arq-lista\"></ul>\n      </div>\n      <div class=\"opcoes\"><label><input type=\"checkbox\" id=\"i-veracidade\"> Declaro que as informações prestadas são verdadeiras e conferem com o registro oficial de lotação.</label></div>\n      <div id=\"i-erros\"></div>\n      <hr class=\"pont\">\n      <div class=\"botoes\"><button class=\"btn\" id=\"i-enviar\" type=\"button\">Enviar impugnação</button></div>\n    </div>\n    <div id=\"i-final\" class=\"oculto\"></div>\n  </section>\n\n  <div class=\"rodape-form\">Sistema de Gestão de Formulários - Tribunal de Justiça do Estado do Acre<br>Versão 1.0</div>\n</main>\n\n<footer class=\"rodape\">\n  <div class=\"wrap\">\n    <div><h4>Tribunal de Justiça do Estado do Acre</h4>Rua Tribunal de Justiça, s/n – Via Verde<br>Rio Branco – AC · CEP 69915-631</div>\n    <div><h4>Prêmio TJAC de Qualidade 2026</h4>Portaria PRESI nº 1.961/2026, alterada pelas Portarias nº 4.335/2026 e nº 4.919/2026.</div>\n    <div><h4>Links</h4><a href=\"https://www.tjac.jus.br\" target=\"_blank\" rel=\"noopener\">Portal do TJAC</a><a href=\"https://www.cnj.jus.br/gestao-estrategica-e-planejamento/premio-cnj-de-qualidade/\" target=\"_blank\" rel=\"noopener\">Prêmio CNJ de Qualidade</a></div>\n  </div>\n  <div class=\"base\">© 2026 Poder Judiciário do Estado do Acre</div>\n</footer>\n\n<dialog id=\"dlg\">\n  <h3 id=\"dlg-tit\"></h3>\n  <div id=\"dlg-txt\"></div>\n  <div class=\"acoes\"><button class=\"btn sec peq\" id=\"dlg-nao\" type=\"button\">Revisar</button><button class=\"btn peq\" id=\"dlg-sim\" type=\"button\">Confirmar envio</button></div>\n</dialog>\n<div class=\"carregando oculto\" id=\"carregando\"><div id=\"carregando-txt\">Enviando…</div></div>\n\n<script>\n/* =====================================================================\n   Dados embutidos pelo scripts/build.py (unidades + matriz do Anexo I)\n   =========================