l;\n  $('r-codigo').textContent = cod||'—';\n  var box=$('r-status-unidade'); box.innerHTML='';\n  if(!cod) return;\n  box.innerHTML='<div class=\"ajuda\">Verificando se a unidade já interpôs recurso…</div>';\n  api('status',{codigo:cod}).then(function(r){\n    estado.statusUnidade=r;\n    if(r.jaInterpos) box.innerHTML='<div class=\"aviso erro\"><strong>Recurso já interposto por esta unidade</strong>Entrada '+esc(r.idEntrada)+', em '+esc(r.dataHora)+'. Novo recurso é inadmissível (preclusão consumativa — art. 7º, § 4º).</div>';\n    else box.innerHTML='<div class=\"aviso ok\"><strong>Nenhum recurso anterior desta unidade.</strong>Atenção: o primeiro envio esgota a faculdade recursal da unidade.</div>';\n  }).catch(function(e){\n    box.innerHTML = e.message==='MODO_DEMO' ? '<div class=\"ajuda\">Modo de demonstração: verificação de preclusão indisponível.</div>' : '<div class=\"aviso alerta\">Não foi possível verificar a situação da unidade: '+esc(e.message)+'</div>';\n  });\n}\n\nfunction validarPasso1(){\n  var erros=[];\n  if(!estado.unidade) erros.push(['r-unidade','Selecione a unidade judiciária.']);\n  if(!cpfValido($('r-cpf').value)) erros.push(['r-cpf','CPF inválido.']);\n  if($('r-nome').value.trim().length<5) erros.push(['r-nome','Informe o nome completo.']);\n  if(!emailValido($('r-email').value)) erros.push(['r-email','E-mail inválido.']);\n  if(!$('r-cargo').value) erros.push(['r-cargo','Informe o cargo/função.']);\n  if(CFG.exigeCodigo && !/^\\d{6}$/.test($('r-codemail').value.trim())) erros.push(['r-codemail','Informe o código de 6 dígitos enviado ao e-mail.']);\n  if(!$('r-matricula').value.trim()) erros.push(['r-matricula','Informe a matrícula.']);\n  if(estado.statusUnidade && estado.statusUnidade.jaInterpos) erros.push(['r-unidade','Esta unidade já interpôs recurso (preclusão consumativa).']);\n  return erros;\n}\nfunction marcarErros(erros, caixa){\n  document.querySelectorAll('.invalido').forEach(function(e){ e.classList.remove('invalido'); });\n  document.querySelectorAll('.erro-campo').forEach(function(e){ e.remove(); });\n  erros.forEach(function(p){ var c=$(p[0]); if(c){ c.classList.add('invalido'); var m=el('div',{class:'erro-campo'},esc(p[1])); c.insertAdjacentElement('afterend',m); } });\n  if(caixa){ caixa.innerHTML = erros.length ? '<div class=\"aviso erro\"><strong>Corrija '+erros.length+' pendência(s) antes de prosseguir:</strong><ul style=\"margin:6px 0 0;padding-left:18px\">'+erros.slice(0,12).map(function(p){return '<li>'+esc(p[1])+'</li>';}).join('')+(erros.length>12?'<li>…</li>':'')+'</ul></div>' : ''; }\n  if(erros.length){ var c=$(erros[0][0]); if(c) c.scrollIntoView({behavior:'smooth',block:'center'}); }\n}\n\nfunction provavel(item, unidade){\n  if(!item.dica || !unidade) return false;\n  return item.dica.some(function(c){ return unidade.competencias.indexOf(c)>=0; });\n}\n\nfunction desenharEixos(){\n  var u=estado.unidade, cat=DADOS.categorias[u.categoria], box=$('r-eixos'); box.innerHTML='';\n  $('r-unidade-resumo').textContent=u.nome+' ('+u.codigo+') — '+cat.rotulo;\n  cat.eixos.forEach(function(chave, i){\n    var eixo=DADOS.eixos[chave], q=i+1, wrap=el('div',{class:'eixo','data-eixo':chave});\n    wrap.innerHTML =\n      '<div class=\"campo\"><div class=\"rot\">'+q+') Você pretende apresentar recurso para algum item relacionado aos '+esc(eixo.titulo)+'? *</div>'+\n      '<div class=\"opcoes\"><label><input type=\"radio\" name=\"ex-'+chave+'\" value=\"Sim\"> Sim</label><label><input type=\"radio\" name=\"ex-'+chave+'\" value=\"Não\"> Não</label></div></div>'+\n      '<div class=\"campo oculto itens-eixo\"><div class=\"rot\">'+q+'.1) Indique o(s) item(ns) dos '+esc(eixo.titulo)+' para o(s) qual(is) deseja apresentar recurso:</div><div class=\"opcoes\">'+\n      eixo.itens.map(function(it){\n        return '<label><input type=\"checkbox\" data-item=\"'+it.n+'\"> Nº '+it.n+' - '+esc(it.sigla)+' - '+esc(it.nome)+\n               '<span class=\"selo pts\">'+it.pontos+' pts</span>'+(provavel(it,u)?'<span class=\"selo prov\" title=\"Competência da unidade compatível com o indicador\">competência compatível</span>':'')+'</label>';\n      }).join('')+'</div><div class=\"ajuda\">'+esc(eixo.fonte)+' da Portaria PRESI nº 1.961/2026 (redação das Portarias nº 4.335 e nº 4.919/2026).</div></div>'+\n      '<div class=\"blocos\"></div>';\n    box.appendChild(wrap);\n    wrap.querySelectorAll('input[type=radio]').forEach(function(r){ r.addEventListener('change',function(){\n      wrap.querySelector('.itens-eixo').classList.toggle('oculto', r.value!=='Sim' || !r.checked);\n      if(r.value==='Não' && r.checked){ wrap.querySelectorAll('input[data-item]').forEach(function(c){ c.checked=false; c.parentNode.classList.remove('marcado'); }); wrap.querySelector('.blocos').innerHTML=''; }\n      atualizarChecklist();\n    }); });\n    wrap.querySelectorAll('input[data-item]').forEach(function(c){ c.addEventListener('change',function(){\n      c.parentNode.classList.toggle('marcado', c.checked); sincronizarBlocos(wrap, eixo); atualizarChecklist();\n    }); });\n    if(i<cat.eixos.length-1) box.appendChild(el('div',{style:'height:6px'}));\n  });\n}\n\nfunction sincronizarBlocos(wrap, eixo){\n  var blocos=wrap.querySelector('.blocos');\n  var marcados=[].slice.call(wrap.querySelectorAll('input[data-item]:checked')).map(function(c){ return +c.getAttribute('data-item'); });\n  [].slice.call(blocos.children).forEach(function(b){ if(marcados.indexOf(+b.getAttribute('data-n'))<0) b.remove(); });\n  eixo.itens.forEach(function(it){\n    if(marcados.indexOf(it.n)<0 || blocos.querySelector('[data-n=\"'+it.n+'\"]')) return;\n    var b=criarBloco(it); var depois=null;\n    [].slice.call(blocos.children).some(function(x){ if(+x.getAttribute('data-n')>it.n){ depois=x; return true; } });\n    blocos.insertBefore(b, depois);\n  });\n}\n\nfunction criarBloco(it){\n  var id='it'+it.n, u=estado.unidade, rot='Nº '+it.n+' - '+it.sigla+' - '+it.nome;\n  var b=el('div',{class:'bloco-recurso','data-n':it.n});\n  b.innerHTML =\n    '<div class=\"rot\">Apresente a seguir o recurso referente ao '+esc(rot)+':</div>'+\n    '<textarea id=\"'+id+'-fund\" class=\"grande\" maxlength=\"'+LIMITE_TEXTO+'\"></textarea>'+\n    '<div class=\"contador\" data-para=\"'+id+'-fund\">0 de '+LIMITE_TEXTO+' máx. de caracteres</div>'+\n    '<fieldset class=\"evid\"><legend>Evidências obrigatórias — Anexo III, item 3 (cláusula de barreira)</legend>'+\n      '<div class=\"subtit\"><span class=\"letra\">a</span>Identificação do painel ou relatório utilizado como base</div>'+\n      '<div class=\"grade\">'+\n        '<div class=\"campo\"><label for=\"'+id+'-ftipo\">Fonte *</label><select id=\"'+id+'-ftipo\" class=\"largo\"><option value=\"\">Selecione…</option>'+\n          ['Painel de BI do PJAC (intranet)','Relatório oficial homologado pela área gestora','DataJud','SEEU','CNIUPS','SNA','CNIEP','Outra fonte oficial'].map(function(o){return '<option>'+o+'</option>';}).join('')+'</select></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-fid\">Nome exato do painel/relatório, aba e endereço *</label><input type=\"text\" id=\"'+id+'-fid\" maxlength=\"300\" placeholder=\"Ex.: BI PJAC › Prêmio TJAC 2026 › aba '+esc(it.sigla)+'\"></div>'+\n      '</div>'+\n      '<div class=\"subtit\"><span class=\"letra\">b</span>Filtros aplicados</div>'+\n      '<div class=\"grade\">'+\n        '<div class=\"campo\"><label for=\"'+id+'-fper\">Período (filtro) *</label><input type=\"text\" id=\"'+id+'-fper\" maxlength=\"100\" value=\"01/01/2026 a 30/11/2026\"></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-fun\">Unidade (filtro) *</label><input type=\"text\" id=\"'+id+'-fun\" maxlength=\"200\" value=\"'+esc(u.nome)+'\"></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-fcl\">Classe processual (filtro) *</label><input type=\"text\" id=\"'+id+'-fcl\" maxlength=\"200\" placeholder=\"Ex.: Todas / Procedimento Comum Cível (7)\"></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-fout\">Outros filtros</label><input type=\"text\" id=\"'+id+'-fout\" maxlength=\"300\" placeholder=\"Assunto, situação, grau…\"></div>'+\n      '</div>'+\n      '<div class=\"subtit\"><span class=\"letra\">c</span>Período de referência utilizado</div>'+\n      '<div class=\"grade\">'+\n        '<div class=\"campo\"><label for=\"'+id+'-ri\">Início *</label><input type=\"date\" id=\"'+id+'-ri\" value=\"'+PERIODO_APURACAO.inicio+'\"></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-rf\">Fim *</label><input type=\"date\" id=\"'+id+'-rf\" value=\"'+PERIODO_APURACAO.fim+'\"></div>'+\n      '</div>'+\n      '<div class=\"subtit\"><span class=\"letra\">d</span>Memória de cálculo detalhada</div>'+\n      '<div class=\"campo\"><label for=\"'+id+'-mem\">Demonstração aritmética e lógica do índice/pontuação pretendida *</label>'+\n        '<textarea id=\"'+id+'-mem\" maxlength=\"'+LIMITE_TEXTO+'\" placeholder=\"Ex.: IAD = baixados ÷ casos novos = 1.050 ÷ 1.000 = 105,0% ≥ 100% → 120 pts (Anexo IV).\"></textarea>'+\n        '<div class=\"contador\" data-para=\"'+id+'-mem\">0 de '+LIMITE_TEXTO+' máx. de caracteres</div></div>'+\n      '<div class=\"grade\">'+\n        '<div class=\"campo\"><label for=\"'+id+'-pa\">Pontuação atribuída no Resultado Preliminar *</label><input type=\"number\" id=\"'+id+'-pa\" min=\"0\" max=\"'+it.pontos+'\" step=\"0.01\"></div>'+\n        '<div class=\"campo\"><label for=\"'+id+'-pp\">Pontuação pretendida *</label><input type=\"number\" id=\"'+id+'-pp\" min=\"0\" max=\"'+it.pontos+'\" step=\"0.01\"><div class=\"ajuda\">Máximo do indicador: '+it.pontos+' pts.</div></div>'+\n      '</div>'+\n      '<div class=\"subtit\"><span class=\"letra\">e</span>Número e quantidade exata dos processos impugnados</div>'+\n      '<div class=\"campo\"><label for=\"'+id+'-proc\">Números dos processos (um por linha, padrão CNJ) *</label>'+\n        '<textarea id=\"'+id+'-proc\" placeholder=\"0700001-23.2026.8.01.0001\"></textarea>'+\n        '<div class=\"ajuda\" id=\"'+id+'-proc-info\">0 processo(s) válido(s).</div></div>'+\n      '<div class=\"campo\" style=\"max-width:260px\"><label for=\"'+id+'-qtd\">Quantidade exata de processos impugnados *</label><input type=\"number\" id=\"'+id+'-qtd\" min=\"1\" step=\"1\"></div>'+\n    '</fieldset>'+\n    '<div class=\"campo arquivo\"><label for=\"'+id+'-arq\">Anexe as evidências do recurso referente ao Nº '+it.n+' - '+esc(it.sigla)+' (capturas do painel, planilhas, relatórios):</label>'+\n      '<input type=\"file\" id=\"'+id+'-arq\" multiple accept=\".pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv,.docx,.doc\"><ul class=\"lista-arq\" id=\"'+id+'-arq-lista\"></ul>'+\n      '<div class=\"ajuda\">Até '+LIMITE_ARQ_MB+' MB por arquivo e '+LIMITE_TOTAL_MB+' MB no total do recurso.</div></div>';\n  setTimeout(function(){\n    ligarContadores(b);\n    $(id+'-proc').addEventListener('input',function(){ var r=lerProcessos($(id+'-proc').value); $(id+'-proc-info').innerHTML=r.validos.length+' processo(s) válido(s)'+(r.invalidos.length?' · <span style=\"color:var(--erro)\">'+r.invalidos.length+' inválido(s): '+esc(r.invalidos.slice(0,3).join('; '))+(r.invalidos.length>3?'…':'')+'</span>':'')+(r.duplicados?' · '+r.duplicados+' repetido(s) ignorado(s)':'')+'.'; atualizarChecklist(); });\n    $(id+'-arq').addEventListener('change',function(){ listarArquivos($(id+'-arq'),$(id+'-arq-lista')); });\n    b.querySelectorAll('input,textarea,select').forEach(function(x){ x.addEventListener('input',atualizarChecklist); x.addEventListener('change',atualizarChecklist); });\n  },0);\n  return b;\n}\n\nfunction lerProcessos(txt){\n  var vistos={}, validos=[], invalidos=[], dup=0;\n  String(txt||'').split(/[\\n;,]+/).map(function(s){return s.trim();}).filter(Boolean).forEach(function(s){\n    var n=cnjNormaliza(s); if(!n){ invalidos.push(s); return; } if(vistos[n]){ dup++; return; } vistos[n]=1; validos.push(n);\n  });\n  return {validos:validos, invalidos:invalidos, duplicados:dup};\n}\nfunction listarArquivos(input, lista){\n  lista.innerHTML=[].slice.call(input.files).map(function(f){ var mb=f.size/1048576; return '<li'+(mb>LIMITE_ARQ_MB?' style=\"color:var(--erro)\"':'')+'>'+esc(f.name)+' ('+mb.toFixed(2)+' MB)</li>'; }).join('');\n}\nfunction ligarContadores(raiz){\n  raiz.querySelectorAll('.contador').forEach(function(c){\n    var t=$(c.getAttribute('data-para')); if(!t) return;\n    var f=function(){ var n=t.value.length, max=+t.getAttribute('maxlength'); c.textContent=n+' de '+max+' máx. de caracteres'; c.classList.toggle('estouro', n>=max); };\n    t.addEventListener('input',f); f();\n  });\n}\n\n/* Coleta e valida o passo 2; devolve {erros, payloadSemArquivos, inputsArquivo} */\nfunction coletarRecurso(){\n  var erros=[], eixos=[], arquivos=[], qtdItens=0, checks={a:true,b:true,c:true,d:true,e:true};\n  var cat=DADOS.categorias[estado.unidade.categoria];\n  cat.eixos.forEach(function(chave){\n    var eixo=DADOS.eixos[chave], wrap=document.querySelector('[data-eixo=\"'+chave+'\"]');\n    var r=wrap.querySelector('input[type=radio]:checked');\n    if(!r){ erros.push(['','Responda se pretende recorrer quanto aos '+eixo.titulo+'.']); checks.ok=false; return; }\n    var reg={chave:chave, titulo:eixo.titulo, resposta:r.value, itens:[]};\n    if(r.value==='Sim'){\n      var marcados=wrap.querySelectorAll('input[data-item]:checked');\n      if(!marcados.length) erros.push(['','Indique ao menos um item dos '+eixo.titulo+' (ou responda \"Não\").']);\n      eixo.itens.forEach(function(it){\n        if(!wrap.querySelector('input[data-item=\"'+it.n+'\"]:checked')) return;\n        qtdItens++;\n        var id='it'+it.n, v=function(s){ return ($(id+'-'+s).value||'').trim(); }, rot='Nº '+it.n+' ('+it.sigla+')';\n        var procs=lerProcessos($(id+'-proc').value);\n        var item={ n:it.n, sigla:it.sigla, nome:it.nome, pontosMax:it.pontos, fundamentacao:v('fund'),\n          evid:{ fonteTipo:v('ftipo'), fonteId:v('fid'), filtroPeriodo:v('fper'), filtroUnidade:v('fun'), filtroClasse:v('fcl'), filtroOutros:v('fout'),\n                 refInicio:v('ri'), refFim:v('rf'), memoria:v('mem'), pontAtribuida:v('pa'), pontPretendida:v('pp'),\n                 processos:procs.validos, qtd:v('qtd') } };\n        if(item.fundamentacao.length<50) erros.push([id+'-fund', rot+': apresente a fundamentação do recurso (mín. 50 caracteres).']);\n        if(!item.evid.fonteTipo || item.evid.fonteId.length<5){ erros.push([item.evid.fonteTipo?id+'-fid':id+'-ftipo', rot+': (a) identifique o painel/relatório.']); checks.a=false; }\n        if(!item.evid.filtroPeriodo || !item.evid.filtroUnidade || !item.evid.filtroClasse){ erros.push([!item.evid.filtroClasse?id+'-fcl':id+'-fper', rot+': (b) informe os filtros de período, unidade e classe processual.']); checks.b=false; }\n        if(!item.evid.refInicio || !item.evid.refFim || item.evid.refInicio>item.evid.refFim){ erros.push([id+'-ri', rot+': (c) período de referência inválido.']); checks.c=false; }\n        var pa=parseFloat(item.evid.pontAtribuida), pp=parseFloat(item.evid.pontPretendida);\n        if(item.evid.memoria.length<30){ erros.push([id+'-mem', rot+': (d) detalhe a memória de cálculo.']); checks.d=false; }\n        if(isNaN(pa)||pa<0||pa>it.pontos){ erros.push([id+'-pa', rot+': (d) pontuação atribuída deve estar entre 0 e '+it.pontos+'.']); checks.d=false; }\n        if(isNaN(pp)||pp<0||pp>it.pontos){ erros.push([id+'-pp', rot+': (d) pontuação pretendida deve estar entre 0 e '+it.pontos+'.']); checks.d=false; }\n        if(!procs.validos.length || procs.invalidos.length){ erros.push([id+'-proc', rot+': (e) informe números de processo válidos no padrão CNJ'+(procs.invalidos.length?' — corrija: '+procs.invalidos.slice(0,2).join('; '):'')+'.']); checks.e=false; }\n        else if(parseInt(item.evid.qtd,10)!==procs.validos.length){ erros.push([id+'-qtd', rot+': (e) a quantidade declarada ('+(item.evid.qtd||'vazia')+') difere dos '+procs.validos.length+' processo(s) listado(s).']); checks.e=false; }\n        var inp=$(id+'-arq'); [].slice.call(inp.files).forEach(function(f){ arquivos.push({n:it.n,arquivo:f}); if(f.size>LIMITE_ARQ_MB*1048576) erros.push([id+'-arq', rot+': o arquivo '+f.name+' excede '+LIMITE_ARQ_MB+' MB.']); });\n        reg.itens.push(item);\n      });\n    }\n    eixos.push(reg);\n  });\n  if(!qtdItens) erros.push(['','Nenhum item foi selecionado. Um envio sem itens consumiria a faculdade recursal da unidade (preclusão) sem efeito útil.']);\n  var total=arquivos.reduce(function(s,a){return s+a.arquivo.size;},0);\n  if(total>LIMITE_TOTAL_MB*1048576) erros.push(['','O total de anexos ('+(total/1048576).toFixed(1)+' MB) excede '+LIMITE_TOTAL_MB+' MB.']);\n  var decl={};\n  document.querySelectorAll('#r-declaracoes input').forEach(function(c){ decl[c.getAttribute('data-decl')]=c.checked; if(!c.checked) erros.push(['','Marque todas as declarações de ciência.']); });\n  return {erros:erros, eixos:eixos, arquivos:arquivos, decl:decl, qtdItens:qtdItens, checks:checks};\n}\n\nfunction atualizarChecklist(){\n  if(!estado.unidade) return;\n  var c=coletarRecurso(), ul=$('r-checklist');\n  if(!c.qtdItens){ ul.innerHTML='<li>Selecione ao menos um item para recorrer.</li>'; return; }\n  var rot={a:'a) Identificação do painel ou relatório',b:'b) Filtros aplicados (período, unidade, classe)',c:'c) Período de referência',d:'d) Memória de cálculo e pontuações',e:'e) Número e quantidade exata dos processos'};\n  ul.innerHTML=Object.keys(rot).map(function(k){ return '<li class=\"'+(c.checks[k]?'ok':'nok')+'\">'+rot[k]+'</li>'; }).join('')+'<li class=\"'+(c.qtdItens?'ok':'nok')+'\">'+c.qtdItens+' item(ns) selecionado(s)</li>';\n  $('r-checklist-box').className='aviso '+(c.checks.a&&c.checks.b&&c.checks.c&&c.checks.d&&c.checks.e?'ok':'alerta');\n}\n\nfunction enviarRecurso(){\n  var c=coletarRecurso();\n  var dedup={}; c.erros=c.erros.filter(function(e){ if(dedup[e[1]]) return false; dedup[e[1]]=1; return true; });\n  marcarErros(c.erros, $('r-erros'));\n  if(c.erros.length) return;\n  var itensTxt=[]; c.eixos.forEach(function(e){ e.itens.forEach(function(i){ itensTxt.push('Nº '+i.n+' - '+i.sigla); }); });\n  confirmar('Confirmar o envio do recurso?',\n    '<p>Unidade: <strong>'+esc(estado.unidade.nome)+'</strong></p><p>Itens: '+esc(itensTxt.join(', '))+'</p>'+\n    '<div class=\"aviso erro\" style=\"margin:12px 0 0\"><strong>Preclusão consumativa</strong>Após o envio, a unidade não poderá apresentar outro recurso nem complementar este (art. 7º, § 4º).</div>'\n  ).then(function(ok){\n    if(!ok) return;\n    mostrarCarregando('Lendo anexos…');\n    Promise.all(c.arquivos.map(function(a){ return lerArquivo(a.arquivo).then(function(r){ r.n=a.n; return r; }); })).then(function(arqs){\n      c.eixos.forEach(function(e){ e.itens.forEach(function(i){ i.arquivos=arqs.filter(function(a){ return a.n===i.n; }); }); });\n      var payload={ unidade:{codigo:estado.unidade.codigo}, respondente:{cpf:$('r-cpf').value, nome:$('r-nome').value.trim(), email:$('r-email').value.trim(), cargo:$('r-cargo').value, matricula:$('r-matricula').value.trim(), codigoEmail:$('r-codemail').value.trim()},\n                    eixos:c.eixos, declaracoes:c.decl, agente:navigator.userAgent };\n      mostrarCarregando('Enviando recurso e gerando o registro…');\n      return api('enviarRecurso', payload);\n    }).then(function(r){\n      esconderCarregando();\n      if(!r || !r.ok){ marcarErros([['', (r&&r.erro)||'Falha no envio.']], $('r-erros')); return; }\n      mostrarFinal('r-final', r, 'Recurso registrado com sucesso'); passo(3);\n    }).catch(function(e){\n      esconderCarregando();\n      marcarErros([['', e.message==='MODO_DEMO' ? 'Modo de demonstração: o formulário foi validado, mas não há servidor configurado para gravar o recurso.' : 'Falha no envio: '+e.message]], $('r-erros'));\n    });\n  });\n}\n\nfunction mostrarFinal(alvo, r, titulo){\n  var box=$(alvo); box.classList.remove('oculto');\n  box.innerHTML='<div class=\"aviso ok\"><strong>'+esc(titulo)+'</strong>ID da Entrada: <strong>'+esc(r.id)+'</strong> · '+esc(r.dataHora)+'</div>'+\n    '<p>O registro em PDF foi gravado no banco do Prêmio'+(r.emailEnviado?' e enviado para <strong>'+esc(r.email)+'</strong>':'')+'.</p>'+\n    (r.pdfBase64?'<div class=\"botoes\"><button class=\"btn\" type=\"button\" id=\"'+alvo+'-pdf\">Baixar o registro (PDF)</button></div>':'');\n  if(r.pdfBase64) $(alvo+'-pdf').onclick=function(){ baixarPDF(r.pdfBase64, r.pdfNome||('Registro_'+r.id+'.pdf')); };\n}\n\n/* =====================================================================\n   IMPUGNAÇÃO DA LISTA DE SERVIDORES\n   ===================================================================== */\nvar contServ=0;\nfunction mesesNoPeriodo(ini, fim){\n  if(!ini||!fim||ini>fim) return null;\n  var a=new Date(Math.max(new Date(ini+'T12:00:00'), new Date(PERIODO_APURACAO.inicio+'T12:00:00')));\n  var b=new Date(Math.min(new Date(fim+'T12:00:00'), new Date(PERIODO_APURACAO.fim+'T12:00:00')));\n  if(a>b) return 0;\n  return Math.round(((b-a)/86400000+1)/30.4375*10)/10;\n}\nfunction addServidor(){\n  var k=++contServ, d=el('div',{class:'servidor','data-k':k});\n  d.innerHTML='<button type=\"button\" class=\"remover\">remover</button>'+\n    '<div class=\"grade\">'+\n      '<div class=\"campo\"><label for=\"s'+k+'-nome\">Nome do(a) servidor(a) *</label><input type=\"text\" id=\"s'+k+'-nome\" maxlength=\"150\"></div>'+\n      '<div class=\"campo\"><label for=\"s'+k+'-mat\">Matrícula *</label><input type=\"text\" id=\"s'+k+'-mat\" maxlength=\"20\"></div>'+\n      '<div class=\"campo\"><label for=\"s'+k+'-tipo\">Pedido *</label><select id=\"s'+k+'-tipo\" class=\"largo\"><option value=\"\">Selecione…</option><option>Inclusão na lista da unidade</option><option>Exclusão da lista da unidade</option><option>Correção de dados/lotação</option></select></div>'+\n      '<div class=\"campo\"><label for=\"s'+k+'-ini\">Lotação na unidade — início *</label><input type=\"date\" id=\"s'+k+'-ini\"></div>'+\n      '<div class=\"campo\"><label for=\"s'+k+'-fim\">Lotação na unidade — fim *</label><input type=\"date\" id=\"s'+k+'-fim\" value=\"'+PERIODO_APURACAO.fim+'\"></div>'+\n    '</div><div class=\"meses\" id=\"s'+k+'-meses\"></div>';\n  $('i-servidores').appendChild(d);\n  var calc=function(){ var m=mesesNoPeriodo($('s'+k+'-ini').value,$('s'+k+'-fim').value); $('s'+k+'-meses').innerHTML = m==null?'':'Tempo de lotação no período de apuração (01/01 a 30/11/2026): <strong>'+m.toString().replace('.',',')+' meses</strong> — '+(m>=6?'<span style=\"color:var(--ok)\">atende ao mínimo de 6 meses (art. 6º)</span>':'<span style=\"color:var(--erro)\">abaixo de 6 meses (art. 6º)</span>'); };\n  $('s'+k+'-ini').addEventListener('change',calc); $('s'+k+'-fim').addEventListener('change',calc);\n  d.querySelector('.remover').onclick=function(){ if(document.querySelectorAll('.servidor').length>1) d.remove(); };\n}\nfunction enviarImpugnacao(){\n  var erros=[], cod=$('i-unidade').value, servidores=[];\n  if(!cod) erros.push(['i-unidade','Selecione a unidade.']);\n  if(!cpfValido($('i-cpf').value)) erros.push(['i-cpf','CPF inválido.']);\n  if(!$('i-matricula').value.trim()) erros.push(['i-matricula','Informe a matrícula.']);\n  if($('i-nome').value.trim().length<5) erros.push(['i-nome','Informe o nome completo.']);\n  if(!emailValido($('i-email').value)) erros.push(['i-email','E-mail inválido.']);\n  if(CFG.exigeCodigo && !/^\\d{6}$/.test($('i-codemail').value.trim())) erros.push(['i-codemail','Informe o código de 6 dígitos enviado ao e-mail.']);\n  document.querySelectorAll('.servidor').forEach(function(d){\n    var k=d.getAttribute('data-k'), g=function(s){ return $('s'+k+'-'+s).value.trim(); };\n    var s={nome:g('nome'),matricula:g('mat'),pedido:g('tipo'),inicio:g('ini'),fim:g('fim')};\n    s.meses=mesesNoPeriodo(s.inicio,s.fim);\n    if(s.nome.length<5) erros.push(['s'+k+'-nome','Informe o nome do(a) servidor(a).']);\n    if(!s.matricula) erros.push(['s'+k+'-mat','Informe a matrícula do(a) servidor(a).']);\n    if(!s.pedido) erros.push(['s'+k+'-tipo','Selecione o pedido.']);\n    if(s.meses==null) erros.push(['s'+k+'-ini','Período de lotação inválido.']);\n    servidores.push(s);\n  });\n  if($('i-fund').value.trim().length<30) erros.push(['i-fund','Apresente a fundamentação (mín. 30 caracteres).']);\n  var arqs=[].slice.call($('i-arq').files), total=0;\n  arqs.forEach(function(f){ total+=f.size; if(f.size>LIMITE_ARQ_MB*1048576) erros.push(['i-arq','O arquivo '+f.name+' excede '+LIMITE_ARQ_MB+' MB.']); });\n  if(total>LIMITE_TOTAL_MB*1048576) erros.push(['i-arq','Total de anexos acima de '+LIMITE_TOTAL_MB+' MB.']);\n  if(!$('i-veracidade').checked) erros.push(['i-veracidade','Marque a declaração de veracidade.']);\n  marcarErros(erros, $('i-erros')); if(erros.length) return;\n  confirmar('Confirmar o envio da impugnação?','<p>Unidade: <strong>'+esc(UNID[cod].nome)+'</strong></p><p>'+servidores.length+' servidor(es) objeto da impugnação.</p>').then(function(ok){\n    if(!ok) return;\n    mostrarCarregando('Enviando impugnação…');\n    Promise.all(arqs.map(lerArquivo)).then(function(lidos){\n      return api('enviarImpugnacao',{ unidade:{codigo:cod}, respondente:{cpf:$('i-cpf').value,nome:$('i-nome').value.trim(),email:$('i-email').value.trim(),matricula:$('i-matricula').value.trim(),codigoEmail:$('i-codemail').value.trim()},\n        servidores:servidores, fundamentacao:$('i-fund').value.trim(), arquivos:lidos, agente:navigator.userAgent });\n    }).then(function(r){\n      esconderCarregando();\n      if(!r||!r.ok){ marcarErros([['',(r&&r.erro)||'Falha no envio.']], $('i-erros')); return; }\n      $('i-form').classList.add('oculto'); mostrarFinal('i-final', r, 'Impugnação registrada com sucesso');\n    }).catch(function(e){ esconderCarregando(); marcarErros([['', e.message==='MODO_DEMO'?'Modo de demonstração: não há servidor configurado para gravar a impugnação.':'Falha no envio: '+e.message]], $('i-erros')); });\n  });\n}\n\nfunction pedirCodigo(pre){\n  var email=$(pre+'-email').value.trim(), info=$(pre+'-cod-info');\n  if(!emailValido(email)){ info.innerHTML='<span style=\"color:var(--erro)\">Informe um e-mail válido antes de pedir o código.</span>'; return; }\n  info.textContent='Enviando código…';\n  api('enviarCodigo',{email:email}).then(function(r){\n    info.innerHTML = r.ok ? '<span style=\"color:var(--ok)\">Código enviado para '+esc(email)+'. Válido por 30 minutos.</span>' : '<span style=\"color:var(--erro)\">'+esc(r.erro)+'</span>';\n  }).catch(function(e){ info.innerHTML = e.message==='MODO_DEMO' ? 'Modo de demonstração: código não enviado (use 123456 para testar a tela).' : '<span style=\"color:var(--erro)\">'+esc(e.message)+'</span>'; });\n}\n\n/* ---------------- inicialização ---------------- */\n(function iniciar(){\n  desenharPrazo();\n  preencherUnidades($('r-unidade'),'');\n  preencherUnidades($('i-unidade'),'');\n  $('r-busca').addEventListener('input',function(){ preencherUnidades($('r-unidade'),this.value); });\n  $('r-unidade').addEventListener('change',aoEscolherUnidade);\n  ['r-cpf','i-cpf'].forEach(function(id){ $(id).addEventListener('input',function(){ this.value=fmtCPF(this.value); }); });\n  $('r-avancar').onclick=function(){\n    var e=validarPasso1(); marcarErros(e, null);\n    if(e.length) return;\n    if(!document.querySelector('#r-eixos .eixo') || $('r-eixos').getAttribute('data-unidade')!==estado.unidade.codigo){ desenharEixos(); $('r-eixos').setAttribute('data-unidade',estado.unidade.codigo); }\n    passo(2); atualizarChecklist();\n  };\n  $('r-voltar').onclick=function(){ passo(1); };\n  $('r-enviar').onclick=enviarRecurso;\n  document.querySelectorAll('#r-declaracoes input').forEach(function(c){ c.addEventListener('change',function(){ c.parentNode.classList.toggle('marcado',c.checked); }); });\n  addServidor(); $('i-add').onclick=addServidor;\n  $('r-pedircod').onclick=function(){ pedirCodigo('r'); }; $('i-pedircod').onclick=function(){ pedirCodigo('i'); };\n  $('i-arq').addEventListener('change',function(){ listarArquivos($('i-arq'),$('i-arq-lista')); });\n  $('i-enviar').onclick=enviarImpugnacao;\n  ligarContadores(document);\n  document.querySelectorAll('.abas button').forEach(function(b){ b.onclick=function(){\n    document.querySelectorAll('.abas button').forEach(function(x){ x.setAttribute('aria-selected', x===b?'true':'false'); });\n    $('aba-recurso').classList.toggle('oculto', b.getAttribute('data-aba')!=='recurso');\n    $('aba-impugnacao').classList.toggle('oculto', b.getAttribute('data-aba')!=='impugnacao');\n  }; });\n  if(temGAS()){ api('config',{}).then(function(c){ if(c&&c.prazo){ PRAZO=c.prazo; } if(c){ CFG.exigeCodigo=!!c.exigeCodigo; ['r','i'].forEach(function(p){ $(p+'-cod-box').classList.toggle('oculto',!CFG.exigeCodigo); }); } desenharPrazo(); if(c&&c.modoTeste) $('faixa-prazo').insertAdjacentHTML('afterbegin','<div class=\"aviso alerta\"><strong>MODO DE TESTE ATIVO</strong>Envios são gravados como teste; prazo, domínio do e-mail e código de verificação não são exigidos.</div>'); }).catch(function(){}); }\n})();\n</script>\n</body>\n</html>\n";

/**
 * Prêmio TJAC de Qualidade 2026 — Sistema de Recursos e Impugnações
 * Portaria PRESI nº 1.961/2026 (alterada pelas Portarias nº 4.335/2026 e nº 4.919/2026)
 *
 * Banco de dados: planilha Google Sheets + pasta do Google Drive da conta que implanta
 * o script. Instalação: execute a função instalar() uma vez (cria pasta, subpastas,
 * planilha e a lista de unidades). Ver README.md do repositório.
 *
 * Abas da planilha:
 *   Unidades      — lista de unidades e categoria de avaliação (editável pela Unidade Gestora)
 *   Recursos      — 1 linha por recurso (cabeçalho do envio)
 *   Itens         — 1 linha por item recorrido, com as evidências do Anexo III e as
 *                   colunas de julgamento da Comissão Revisora
 *   Impugnacoes   — 1 linha por servidor(a) impugnado(a)
 *   Relatorios_Finais — índice dos relatórios finais gerados por unidade
 *   Log           — registro técnico de eventos
 */

