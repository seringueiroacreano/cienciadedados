indow.confirm(titulo));\n  });\n}\nfunction baixarPDF(base64, nome){\n  var bin=atob(base64), arr=new Uint8Array(bin.length); for(var i=0;i<bin.length;i++) arr[i]=bin.charCodeAt(i);\n  var url=URL.createObjectURL(new Blob([arr],{type:'application/pdf'}));\n  var a=el('a',{href:url,download:nome}); document.body.appendChild(a); a.click(); a.remove();\n  setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);\n}\n\n/* ---------------- comunicação com o servidor (Apps Script) ---------------- */\nfunction temGAS(){ return typeof google!=='undefined' && google.script && google.script.run; }\nfunction endpoint(){ var p=new URLSearchParams(location.search).get('api'); return p || ENDPOINT; }\nfunction api(acao, dados){\n  if(temGAS()){\n    return new Promise(function(ok,falha){\n      google.script.run.withSuccessHandler(function(r){ ok(typeof r==='string'?JSON.parse(r):r); }).withFailureHandler(falha).api(acao, JSON.stringify(dados||{}));\n    });\n  }\n  var url=endpoint();\n  if(!url) return Promise.reject(new Error('MODO_DEMO'));\n  return fetch(url,{method:'POST',body:JSON.stringify({acao:acao,dados:dados||{}})}).then(function(r){ return r.json(); });\n}\n\n/* ---------------- dados auxiliares ---------------- */\nvar UNID = {}; DADOS.unidades.forEach(function(u){ UNID[u.codigo]=u; });\nvar AVALIADAS = DADOS.unidades.filter(function(u){ return DADOS.categorias[u.categoria] && DADOS.categorias[u.categoria].avaliada; });\n\nfunction preencherUnidades(sel, filtro){\n  var atual=sel.value; sel.innerHTML='';\n  sel.appendChild(el('option',{value:''},'Selecione a unidade…'));\n  var grupos={};\n  var f=(filtro||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase();\n  AVALIADAS.forEach(function(u){\n    var nome=u.nome.normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase();\n    if(f && nome.indexOf(f)<0 && u.codigo.indexOf(f)<0) return;\n    var g=DADOS.categorias[u.categoria].rotulo; (grupos[g]=grupos[g]||[]).push(u);\n  });\n  Object.keys(grupos).forEach(function(g){