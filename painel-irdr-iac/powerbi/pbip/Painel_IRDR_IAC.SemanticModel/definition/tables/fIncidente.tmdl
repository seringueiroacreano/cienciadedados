table fIncidente
	lineageTag: c9b69500-7166-522f-844a-421bdbdce1c8

	measure 'Incidentes' = DISTINCTCOUNT ( fIncidente[numero] )
		formatString: 0
		displayFolder: Incidentes
		lineageTag: bce76f40-adde-5187-865c-c589289f1ec8

	measure 'Incidentes no Período' = CALCULATE ( [Incidentes], fIncidente[sus] = 1 )
		formatString: 0
		displayFolder: Incidentes
		lineageTag: 053104c4-27b5-56f5-af43-3d54b4830c46

	measure 'Eventos SUS' = SUM ( fIncidente[sus] )
		formatString: 0
		displayFolder: Incidentes
		lineageTag: a8b450ae-25e9-56d3-8d83-1c9cb9645256

	measure 'Eventos TESE' = SUM ( fIncidente[tese] )
		formatString: 0
		displayFolder: Incidentes
		lineageTag: f8fdd9aa-ef37-5b82-84aa-2b6126a948a0

	measure 'Incidentes com Alerta' = CALCULATE ( [Incidentes], fIncidente[alertas] <> "" )
		formatString: 0
		displayFolder: Incidentes
		lineageTag: aebb8da7-ce01-5364-a533-6093f4112492

	measure 'Pontos SUS' = SUMX ( fIncidente, 10 * fIncidente[sus] * fIncidente[selecionado] )
		formatString: 0
		displayFolder: Pontuação
		lineageTag: b8aed082-dbfb-52b2-935a-3fc9c8d2a375

	measure 'Pontos TESE' = SUMX ( fIncidente, 25 * fIncidente[tese] * fIncidente[selecionado] )
		formatString: 0
		displayFolder: Pontuação
		lineageTag: 896a53a6-1962-5a48-9f18-5353bbe00486

	measure 'Pontos' = SUM ( fIncidente[pontos] ) + 0
		formatString: 0
		displayFolder: Pontuação
		lineageTag: c3e54d16-5686-5846-9aa8-4c80ae028061

	measure 'Teto' = 70 * CALCULATE ( COUNTROWS ( dGabinete ), dGabinete[elegivel] = TRUE () )
		formatString: 0
		displayFolder: Pontuação
		lineageTag: 9ef4c7e6-6818-5888-b6f9-8f4662188851

	measure '% do Teto' = DIVIDE ( [Pontos], [Teto] )
		formatString: 0.0%
		displayFolder: Pontuação
		lineageTag: ab1a9b40-eef8-5ddb-ba47-6d76fb7206de

	measure 'Pontos Não Computados' = SUM ( fIncidente[potencial] ) - [Pontos]
		formatString: 0
		displayFolder: Pontuação
		lineageTag: e8db92d9-732a-5811-b97b-682a55fb950b

	measure 'Gabinetes Pontuando' = COUNTROWS ( FILTER ( VALUES ( dGabinete[gabinete] ), [Pontos] > 0 ) ) + 0
		formatString: 0
		displayFolder: Pontuação
		lineageTag: b00e23c0-b0dd-5f20-ac62-956acf5deb02

	measure 'Atualizado' = "Atualizado: " & FORMAT ( MAX ( dCarga[atualizado_em] ), "dd/mm/yyyy hh:mm:ss" )
		displayFolder: Rótulos
		lineageTag: 18ac5716-fb80-5cfc-be71-9eecef1f5788

	measure 'Carga DataJud' = "Última carga do TJAC no DataJud: " & FORMAT ( MAX ( dCarga[ultima_carga_datajud] ), "dd/mm/yyyy" ) & "  ·  Apuração até " & FORMAT ( MAX ( dCarga[fim_apuracao] ), "dd/mm/yyyy" )
		displayFolder: Rótulos
		lineageTag: 74eef3c3-77ea-55c1-bc4b-8463bbbf8ced

