	column codigo
		dataType: int64
		formatString: 0
		lineageTag: 08e4f33f-a0eb-5f8f-a743-ea8866a39d81
		summarizeBy: none
		sourceColumn: codigo

		annotation SummarizationSetBy = Automatic

