model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataJud_Chave", "Periodo_Inicio", "Periodo_Fim", "DataJud_Post", "DataJud_Bruto", "dCarga", "dGabinete", "fIncidente", "fMovimento"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dCarga
ref table dGabinete
ref table fIncidente
ref table fMovimento

